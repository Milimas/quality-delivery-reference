#!/bin/sh
set -eu

GITLEAKS_IMAGE=${GITLEAKS_IMAGE:-ghcr.io/gitleaks/gitleaks:v8.30.1}
repo_root=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd)
target=${1:-$repo_root}

case "$target" in
  /*) ;;
  *) target=$(CDPATH= cd -- "$target" && pwd) ;;
esac

docker run --rm \
  -v "$target:/scan:ro" \
  -v "$repo_root/.gitleaks.toml:/config/.gitleaks.toml:ro" \
  "$GITLEAKS_IMAGE" dir /scan \
  --config /config/.gitleaks.toml \
  --redact \
  --no-banner

if [ "$target" = "$repo_root" ]; then
  make -C "$repo_root" tool CMD='pnpm audit --prod'
fi
